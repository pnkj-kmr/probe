                "poll_type"
            ],
            "properties": {
                "mib_profile": {
                    "type": "string"
                },
                "packsiz": {
                    "type": "integer"
                },
                "parent_ci_id": {
                    "type": "string"
                },
                "poll_addr": {
                    "type": "string"
                },
                "poll_addr_list": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "poll_period": {
                    "type": "integer",
                    "enum": [
                        5,
                        60,
                        300
                    ]
                },
                "poll_type": {
                    "type": "string",
                    "enum": [
                        "ping"
                    ]
                }
            }
        },
        "M.ProtocolType": {
            "type": "string",
            "enum": [
                "snmp",
                "http",
                "https",
                "ssh",
                "sftp",
                "telnet"
            ],
            "x-enum-varnames": [
                "SNMPType",
                "HTTPType",
                "HTTPSType",
                "SSHType",
                "SFTPType",
                "TELNETType"
            ]
        },
        "M.SNMPOperation": {
            "type": "integer",
            "enum": [
                1,
                2,
                3
            ],
            "x-enum-varnames": [
                "GET",
                "WALK",
                "BULKWALK"
            ]
        },
        "M.SNMPParams": {
            "type": "object",
            "required": [
                "poll_period",
                "poll_type"
            ],
            "properties": {
                "ci_category": {
                    "type": "string"
                },
                "ci_name": {
                    "type": "string"
                },
                "custom_type": {
                    "description": "OidIndex   string `json:\"oidIndex\"`",
                    "type": "string"
                },
                "memory_size": {
                    "type": "integer"
                },
                "mib_profile": {
                    "type": "string"
                },
                "parent_ci_id": {
                    "type": "string"
                },
                "poll_addr": {
                    "type": "string"
                },
                "poll_addr_list": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "poll_period": {
                    "type": "integer",
                    "enum": [
                        60,
                        300
                    ]
                },
                "poll_type": {
                    "type": "string",
                    "enum": [
                        "snmp"
                    ]
                },
                "speed": {
                    "type": "integer"
                }
            }
        },
        "M.SNMPReq": {
            "type": "object",
            "required": [
                "ci_id",
                "login_profileid",
                "poll_addr"
            ],
            "properties": {
                "ci_id": {
                    "type": "string"
                },
                "input_stats": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/M.InputStat"
                    }
                },
                "login_profileid": {
                    "type": "string"
                },
                "params": {
                    "$ref": "#/definitions/M.SNMPParams"
                },
                "poll_addr": {
                    "type": "string"
                }
            }
        },
        "M.SNMPVersion": {
            "type": "string",
            "enum": [
                "1",
                "2c",
                "3"
            ],
            "x-enum-varnames": [
                "VERSION1",
                "VERSION2C",
                "VERSION3"
            ]
        }
    }
