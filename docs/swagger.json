                    "type": "string"
                },
                "priv_type": {
                    "type": "string"
                },
                "protocol_type": {
                    "enum": [
                        "snmp"
                    ],
                    "allOf": [
                        {
                            "$ref": "#/definitions/M.ProtocolType"
                        }
                    ]
                },
                "request_type": {
                    "$ref": "#/definitions/M.SNMPOperation"
                },
                "retries": {
