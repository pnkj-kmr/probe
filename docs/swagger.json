    "definitions": {
        "M.AuthHTTP": {
            "type": "object",
            "required": [
                "login_profileid",
                "name",
                "protocol_type"
            ],
            "properties": {
                "credentialtype": {
                    "type": "string"
                },
                "host": {
                    "type": "string"
                },
                "login_profileid": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "no_of_custom_pairs": {
                    "type": "integer"
                },
                "password": {
                    "type": "string"
                },
                "port": {
                    "type": "string"
                },
                "protocol_type": {
                    "enum": [
                        "http",
                        "https"
                    ],
                    "allOf": [
                        {
                            "$ref": "#/definitions/M.ProtocolType"
                        }
                    ]
                },
                "retries": {
                    "type": "integer"
                },
                "timeout": {
                    "type": "integer"
                },
                "type": {
                    "type": "string"
                },
                "url": {
                    "type": "string"
                },
                "username": {
                    "type": "string"
                }
            }
        },
